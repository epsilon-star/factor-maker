/* FactorMaker — dark system theme */

* {
	outline: none;
}

QMainWindow {
	background-color: #0f141c;
}

QWidget#FactorRoot {
	background-color: #0f141c;
	color: #e7eef7;
	font-size: 13px;
}

QLabel {
	color: #e7eef7;
	background: transparent;
}

QLabel#BrandTitle {
	font-size: 20px;
	font-weight: 700;
	color: #7eb6ea;
	letter-spacing: 0.2px;
}

QLabel#SectionTitle {
	font-size: 13px;
	font-weight: 700;
	color: #7eb6ea;
	padding: 2px 0 6px 0;
}

QLabel#FieldLabel {
	color: #9aabbc;
	font-size: 12px;
	font-weight: 600;
	min-width: 72px;
	max-width: 88px;
}

QLabel#HintLabel {
	color: #7d8c9c;
	font-size: 11px;
}

QLabel#TotalLabel {
	font-size: 16px;
	font-weight: 700;
	color: #9cc7f0;
}

QFrame#HeaderBar,
QFrame#FooterBar,
QFrame#ContentCard {
	background-color: #171e29;
	border: 1px solid #2a3545;
	border-radius: 12px;
}

QFrame#SectionBox {
	background-color: transparent;
	border: none;
}

QFrame#SoftDivider {
	background-color: #2a3545;
	border: none;
	max-width: 1px;
	min-width: 1px;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QDoubleSpinBox {
	background-color: #121821;
	color: #e7eef7;
	border: 1px solid #334155;
	border-radius: 8px;
	padding: 7px 10px;
	min-height: 18px;
	selection-background-color: #2563eb;
	selection-color: #ffffff;
}

QLineEdit:focus,
QTextEdit:focus,
QComboBox:focus,
QDoubleSpinBox:focus {
	border: 1px solid #3b82f6;
	background-color: #0f1520;
}

QComboBox {
	padding: 7px 10px;
	min-width: 170px;
	min-height: 20px;
}

QComboBox::drop-down {
	subcontrol-origin: padding;
	subcontrol-position: center left;
	width: 26px;
	border: none;
	background: transparent;
}

QComboBox QAbstractItemView {
	background-color: #171e29;
	color: #e7eef7;
	border: 1px solid #334155;
	selection-background-color: #243247;
	selection-color: #9cc7f0;
	outline: none;
	padding: 4px;
}

QDoubleSpinBox {
	padding-right: 4px;
}

QTableWidget {
	background-color: #121821;
	alternate-background-color: #171e29;
	color: #e7eef7;
	border: 1px solid #334155;
	border-radius: 8px;
	gridline-color: #243041;
	selection-background-color: #243247;
	selection-color: #e7eef7;
}

QHeaderView::section {
	background-color: #1c2533;
	color: #9cc7f0;
	padding: 8px 6px;
	border: none;
	border-bottom: 1px solid #2a3545;
	font-weight: 700;
}

QTableWidget::item {
	padding: 4px;
}

QPushButton {
	background-color: #1c2533;
	color: #9cc7f0;
	border: 1px solid #334155;
	border-radius: 8px;
	padding: 7px 14px;
	font-weight: 600;
	min-height: 18px;
}

QPushButton:hover {
	background-color: #243247;
}

QPushButton:pressed {
	background-color: #1a2330;
}

QPushButton#PrimaryButton {
	background-color: #2563eb;
	color: #ffffff;
	border: 1px solid #1d4ed8;
	padding: 10px 28px;
	font-size: 14px;
	border-radius: 10px;
	min-width: 140px;
}

QPushButton#PrimaryButton:hover {
	background-color: #3b82f6;
}

QPushButton#PrimaryButton:pressed {
	background-color: #1d4ed8;
}

QPushButton#SecondaryButton {
	background-color: #171e29;
	color: #9cc7f0;
	border: 1px solid #334155;
}

QPushButton#DangerButton {
	background-color: #2a1717;
	color: #f0a8a2;
	border: 1px solid #5c2d2d;
}

QPushButton#DangerButton:hover {
	background-color: #3a1d1d;
}

QPushButton#ThemeChip,
QPushButton#ThemeBlue,
QPushButton#ThemeCyan,
QPushButton#ThemeGray,
QPushButton#ThemeRed {
	background-color: #1c2533;
	color: #9aabbc;
	border: 1px solid #334155;
	border-radius: 14px;
	padding: 6px 16px;
	font-weight: 600;
	min-width: 64px;
}

QPushButton#ThemeChip:hover,
QPushButton#ThemeBlue:hover,
QPushButton#ThemeCyan:hover,
QPushButton#ThemeGray:hover,
QPushButton#ThemeRed:hover {
	background-color: #243247;
}

QPushButton#ThemeBlue:checked {
	background-color: #2563eb;
	color: #ffffff;
	border: 1px solid #1d4ed8;
}

QPushButton#ThemeCyan:checked {
	background-color: #0891b2;
	color: #ffffff;
	border: 1px solid #0e7490;
}

QPushButton#ThemeGray:checked {
	background-color: #64748b;
	color: #ffffff;
	border: 1px solid #475569;
}

QPushButton#ThemeRed:checked {
	background-color: #dc2626;
	color: #ffffff;
	border: 1px solid #b91c1c;
}

QPushButton#RowDeleteButton {
	background-color: #2a1717;
	color: #f0a8a2;
	border: 1px solid #5c2d2d;
	border-radius: 6px;
	padding: 3px 10px;
	font-size: 12px;
}

QPushButton#AddItemButton {
	background-color: #182433;
	color: #9cc7f0;
	border: 1px dashed #3b5573;
	border-radius: 8px;
	padding: 9px 14px;
}

QPushButton#AddItemButton:hover {
	background-color: #1e2d40;
	border-style: solid;
}

QScrollArea {
	border: none;
	background: transparent;
}

QScrollArea > QWidget > QWidget {
	background: transparent;
}

QScrollBar:vertical {
	background: transparent;
	width: 10px;
	margin: 2px;
}

QScrollBar::handle:vertical {
	background: #3a4a5e;
	border-radius: 5px;
	min-height: 30px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
	background: none;
	height: 0;
}

QMessageBox {
	background-color: #171e29;
	color: #e7eef7;
}

QDialog {
	background-color: #0f141c;
	color: #e7eef7;
}

QCheckBox {
	color: #e7eef7;
	spacing: 8px;
}

QCheckBox::indicator {
	width: 16px;
	height: 16px;
	border: 1px solid #334155;
	border-radius: 4px;
	background: #121821;
}

QCheckBox::indicator:checked {
	background: #2563eb;
	border-color: #2563eb;
}
