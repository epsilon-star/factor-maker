/* FactorMaker — clean Meta-Noia UI */

* {
	outline: none;
}

QMainWindow {
	background-color: #f3f6fb;
}

QWidget#FactorRoot {
	background-color: #f3f6fb;
	color: #152033;
	font-size: 13px;
}

QLabel {
	color: #152033;
	background: transparent;
}

QLabel#BrandTitle {
	font-size: 20px;
	font-weight: 700;
	color: #0a4a82;
	letter-spacing: 0.2px;
}

QLabel#SectionTitle {
	font-size: 13px;
	font-weight: 700;
	color: #0a4a82;
	padding: 2px 0 6px 0;
	qproperty-alignment: AlignRight;
}

QLabel#FieldLabel {
	color: #5b6b7c;
	font-size: 12px;
	font-weight: 600;
	min-width: 78px;
	qproperty-alignment: AlignRight;
}

QLabel#HintLabel {
	color: #7a8a9a;
	font-size: 11px;
}

QLabel#TotalLabel {
	font-size: 16px;
	font-weight: 700;
	color: #0a4a82;
	qproperty-alignment: AlignRight;
}

QProgressBar {
	background-color: #eef3f9;
	border: 1px solid #cfd9e6;
	border-radius: 8px;
	text-align: center;
	color: #0a4a82;
	min-height: 20px;
}

QProgressBar::chunk {
	background-color: #0a4a82;
	border-radius: 7px;
}

QFrame#HeaderBar,
QFrame#FooterBar,
QFrame#ContentCard {
	background-color: #ffffff;
	border: 1px solid #d9e2ec;
	border-radius: 12px;
}

QFrame#SectionBox {
	background-color: transparent;
	border: none;
}

QFrame#SoftDivider {
	background-color: #e6edf5;
	border: none;
	max-width: 1px;
	min-width: 1px;
}

QLineEdit,
QTextEdit,
QPlainTextEdit {
	background-color: #f8fafc;
	color: #152033;
	border: 1px solid #cfd9e6;
	border-radius: 8px;
	padding: 7px 10px;
	min-height: 18px;
	selection-background-color: #0a4a82;
	selection-color: #ffffff;
}

QLineEdit:focus,
QTextEdit:focus {
	border: 1px solid #0a4a82;
	background-color: #ffffff;
}

QComboBox {
	background-color: #f8fafc;
	color: #152033;
	border: 1px solid #cfd9e6;
	border-radius: 8px;
	padding: 6px 12px 6px 32px;
	min-width: 170px;
	min-height: 22px;
	selection-background-color: #0a4a82;
	selection-color: #ffffff;
}

QComboBox:hover {
	border: 1px solid #9bb6d4;
	background-color: #ffffff;
}

QComboBox:focus {
	border: 1px solid #0a4a82;
	background-color: #ffffff;
}

QComboBox::drop-down {
	subcontrol-origin: padding;
	subcontrol-position: center left;
	width: 28px;
	border: none;
	border-right: 1px solid #e2e8f0;
	background-color: #eef3f9;
	border-top-left-radius: 8px;
	border-bottom-left-radius: 8px;
}

QComboBox::down-arrow {
	image: url(icons/chevron-down.png);
	width: 12px;
	height: 12px;
}

QComboBox QAbstractItemView {
	background-color: #ffffff;
	color: #152033;
	border: 1px solid #cfd9e6;
	border-radius: 8px;
	selection-background-color: #e8f1fb;
	selection-color: #0a4a82;
	outline: none;
	padding: 6px;
}

QComboBox QAbstractItemView::item {
	min-height: 28px;
	padding: 4px 10px;
	border-radius: 4px;
}

QAbstractSpinBox,
QDoubleSpinBox,
QSpinBox {
	background-color: #f8fafc;
	color: #152033;
	border: 1px solid #cfd9e6;
	border-radius: 8px;
	padding: 6px 8px 6px 34px;
	min-height: 22px;
	selection-background-color: #0a4a82;
	selection-color: #ffffff;
}

QAbstractSpinBox:hover,
QDoubleSpinBox:hover,
QSpinBox:hover {
	border: 1px solid #9bb6d4;
	background-color: #ffffff;
}

QAbstractSpinBox:focus,
QDoubleSpinBox:focus,
QSpinBox:focus {
	border: 1px solid #0a4a82;
	background-color: #ffffff;
}

QAbstractSpinBox::up-button,
QDoubleSpinBox::up-button,
QSpinBox::up-button {
	subcontrol-origin: border;
	subcontrol-position: top left;
	width: 26px;
	height: 16px;
	border: none;
	border-right: 1px solid #e2e8f0;
	border-bottom: 1px solid #e2e8f0;
	background-color: #eef3f9;
	border-top-left-radius: 8px;
}

QAbstractSpinBox::down-button,
QDoubleSpinBox::down-button,
QSpinBox::down-button {
	subcontrol-origin: border;
	subcontrol-position: bottom left;
	width: 26px;
	height: 16px;
	border: none;
	border-right: 1px solid #e2e8f0;
	background-color: #eef3f9;
	border-bottom-left-radius: 8px;
}

QAbstractSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QSpinBox::up-button:hover,
QAbstractSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover,
QSpinBox::down-button:hover {
	background-color: #dceaf8;
}

QAbstractSpinBox::up-button:pressed,
QDoubleSpinBox::up-button:pressed,
QSpinBox::up-button:pressed,
QAbstractSpinBox::down-button:pressed,
QDoubleSpinBox::down-button:pressed,
QSpinBox::down-button:pressed {
	background-color: #c5d8ec;
}

QAbstractSpinBox::up-arrow,
QDoubleSpinBox::up-arrow,
QSpinBox::up-arrow {
	image: url(icons/chevron-up.png);
	width: 10px;
	height: 10px;
}

QAbstractSpinBox::down-arrow,
QDoubleSpinBox::down-arrow,
QSpinBox::down-arrow {
	image: url(icons/spin-down.png);
	width: 10px;
	height: 10px;
}

QTableWidget {
	background-color: #ffffff;
	alternate-background-color: #f8fafc;
	color: #152033;
	border: 1px solid #cfd9e6;
	border-radius: 8px;
	gridline-color: #e8eef5;
	selection-background-color: #e8f1fb;
	selection-color: #152033;
}

QHeaderView::section {
	background-color: #eef3f9;
	color: #0a4a82;
	padding: 8px 6px;
	border: none;
	border-bottom: 1px solid #d9e2ec;
	font-weight: 700;
	text-align: right;
}

QTableWidget::item {
	padding: 4px;
}

QPushButton {
	background-color: #eef3f9;
	color: #0a4a82;
	border: 1px solid #c5d3e4;
	border-radius: 8px;
	padding: 7px 14px;
	font-weight: 600;
	min-height: 18px;
}

QPushButton:hover {
	background-color: #e1ebf6;
}

QPushButton:pressed {
	background-color: #d2e0f0;
}

QPushButton#PrimaryButton {
	background-color: #0a4a82;
	color: #ffffff;
	border: 1px solid #083a67;
	padding: 10px 28px;
	font-size: 14px;
	border-radius: 10px;
	min-width: 140px;
}

QPushButton#PrimaryButton:hover {
	background-color: #0c5a9c;
}

QPushButton#PrimaryButton:pressed {
	background-color: #083a67;
}

QPushButton#SecondaryButton {
	background-color: #ffffff;
	color: #0a4a82;
	border: 1px solid #c5d3e4;
}

QPushButton#DangerButton {
	background-color: #fff5f4;
	color: #b42318;
	border: 1px solid #f0c7c2;
}

QPushButton#DangerButton:hover {
	background-color: #ffe9e6;
}

QPushButton#ThemeChip,
QPushButton#ThemeBlue,
QPushButton#ThemeCyan,
QPushButton#ThemeGray,
QPushButton#ThemeRed,
QPushButton#ThemeYellow,
QPushButton#ThemeGreen {
	background-color: #f3f6fa;
	color: #5b6b7c;
	border: 1px solid #cfd9e6;
	border-radius: 14px;
	padding: 6px 16px;
	font-weight: 600;
	min-width: 64px;
}

QPushButton#ThemeChip:hover,
QPushButton#ThemeBlue:hover,
QPushButton#ThemeCyan:hover,
QPushButton#ThemeGray:hover,
QPushButton#ThemeRed:hover,
QPushButton#ThemeYellow:hover,
QPushButton#ThemeGreen:hover {
	background-color: #e8eef5;
}

QPushButton#ThemeBlue:checked {
	background-color: #2563eb;
	color: #ffffff;
	border: 1px solid #1d4ed8;
}

QPushButton#ThemeCyan:checked {
	background-color: #0891b2;
	color: #ffffff;
	border: 1px solid #0e7490;
}

QPushButton#ThemeGray:checked {
	background-color: #64748b;
	color: #ffffff;
	border: 1px solid #475569;
}

QPushButton#ThemeRed:checked {
	background-color: #dc2626;
	color: #ffffff;
	border: 1px solid #b91c1c;
}

QPushButton#ThemeYellow:checked {
	background-color: #ca8a04;
	color: #ffffff;
	border: 1px solid #a16207;
}

QPushButton#ThemeGreen:checked {
	background-color: #16a34a;
	color: #ffffff;
	border: 1px solid #15803d;
}

QPushButton#RowDeleteButton {
	background-color: #fff5f4;
	color: #b42318;
	border: 1px solid #f0c7c2;
	border-radius: 6px;
	padding: 3px 10px;
	font-size: 12px;
}

QPushButton#AddItemButton {
	background-color: #e8f1fb;
	color: #0a4a82;
	border: 1px dashed #9bb6d4;
	border-radius: 8px;
	padding: 9px 14px;
}

QPushButton#AddItemButton:hover {
	background-color: #dceaf8;
	border-style: solid;
}

QScrollArea {
	border: none;
	background: transparent;
}

QScrollArea > QWidget > QWidget {
	background: transparent;
}

QScrollBar:vertical {
	background: transparent;
	width: 10px;
	margin: 2px;
}

QScrollBar::handle:vertical {
	background: #c5d3e4;
	border-radius: 5px;
	min-height: 30px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
	background: none;
	height: 0;
}

QMessageBox {
	background-color: #ffffff;
}

QDialog {
	background-color: #f3f6fb;
}

QCheckBox {
	color: #152033;
	spacing: 8px;
}

QCheckBox::indicator {
	width: 16px;
	height: 16px;
	border: 1px solid #cfd9e6;
	border-radius: 4px;
	background: #ffffff;
}

QCheckBox::indicator:checked {
	background: #0a4a82;
	border-color: #0a4a82;
}
